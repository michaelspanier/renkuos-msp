From 6af0c53fe456c13ae3d58b9556ce969eae613a74 Mon Sep 17 00:00:00 2001
From: Michael Spanier <spanier.michael@gmail.com>
Date: Fri, 20 Nov 2026 22:07:31 +0100
Subject: [PATCH 04/34] usb: end transfers before switching an alternate
 setting

Device::SetAltInterface() sent SET_INTERFACE first and deleted the
pipes of the old setting afterwards. That had two effects when
transfers were still queued on them:

- ~Pipe() cancels with force, which deletes the transfers without
  calling their callbacks. A driver waiting for a callback waits
  forever. usb_raw does that for every transfer, so its thread hung
  and the team could not be killed.
- The built-in camera of a ThinkPad T470s (USB 04ca:7066) stopped
  answering on its default pipe after the setting changed under
  running isochronous transfers, until the next reboot.

Remove the old pipes before sending the request, and cancel their
transfers without force, since the driver that asked for the change
is still alive. Put each pipe's ID and wait for idle first, so that
no transfer can be queued after the cancel. If the request fails, the
old setting gets new pipes. Other callers of ClearEndpoints() keep the
forced cancel, as the owner of the transfers may be gone there.

Signed-off-by: Michael Spanier <spanier.michael@gmail.com>
Assisted-by: claude-opus-5-5
(cherry picked from commit 523739fdccef33503b765587048ac0352ecaa7be)
---
 .../kernel/bus_managers/usb/Device.cpp        | 42 ++++++++++++++++---
 .../kernel/bus_managers/usb/usb_private.h     |  5 +++
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/src/add-ons/kernel/bus_managers/usb/Device.cpp b/src/add-ons/kernel/bus_managers/usb/Device.cpp
index b85fd496c1..1e8289f71c 100644
--- a/src/add-ons/kernel/bus_managers/usb/Device.cpp
+++ b/src/add-ons/kernel/bus_managers/usb/Device.cpp
@@ -682,6 +682,28 @@ Device::Unconfigure(bool atDeviceLevel)
 
 void
 Device::ClearEndpoints(int32 interfaceIndex)
+{
+	_RemoveEndpointPipes(interfaceIndex, false);
+}
+
+
+/*!	Stops new transfers on \a pipe and cancels the queued ones, calling their
+	callbacks. ~Pipe() cancels by force and skips the callbacks, so a caller
+	still waiting for one would wait forever. Only use this while the owner of
+	the transfers is still alive.
+*/
+void
+Device::_CancelPipeTransfers(Pipe* pipe)
+{
+	// Put the ID first and wait for submissions that already hold a reference,
+	// so that no transfer can be queued after the cancel.
+	pipe->PutUSBID(true);
+	pipe->CancelQueuedTransfers(false);
+}
+
+
+void
+Device::_RemoveEndpointPipes(int32 interfaceIndex, bool cancelTransfers)
 {
 	if (fCurrentConfiguration == NULL
 		|| fCurrentConfiguration->interface == NULL)
@@ -699,8 +721,11 @@ Device::ClearEndpoints(int32 interfaceIndex)
 		for (size_t i = 0; i < interfaceInfo->endpoint_count; i++) {
 			usb_endpoint_info* endpoint = &interfaceInfo->endpoint[i];
 			Pipe* pipe = (Pipe*)GetStack()->GetObject(endpoint->handle);
-			if (pipe != NULL)
+			if (pipe != NULL) {
 				pipe->ReleaseReference();
+				if (cancelTransfers)
+					_CancelPipeTransfers(pipe);
+			}
 			delete pipe;
 			endpoint->handle = 0;
 		}
@@ -712,16 +737,23 @@ status_t
 Device::SetAltInterface(const usb_interface_info* interface)
 {
 	uint8 interfaceNumber = interface->descr->interface_number;
+
+	// End the transfers of the old setting before the device switches: some
+	// devices stop working when the setting changes under running isochronous
+	// transfers. The driver that asked for the change is still there, so its
+	// queued transfers get their callbacks.
+	_RemoveEndpointPipes(interfaceNumber, true);
+
 	// Tell the device to set the alternate settings
 	status_t result = fDefaultPipe->SendRequest(
 		USB_REQTYPE_INTERFACE_OUT | USB_REQTYPE_STANDARD,
 		USB_REQUEST_SET_INTERFACE,
 		interface->descr->alternate_setting, interfaceNumber, 0, NULL, 0, NULL);
-	if (result < B_OK)
+	if (result < B_OK) {
+		// The old setting stays active, give it new pipes.
+		InitEndpoints(interfaceNumber);
 		return result;
-
-	// Clear the no longer active endpoints
-	ClearEndpoints(interfaceNumber);
+	}
 
 	// Update the active pointer of the interface list
 	usb_interface_list* interfaceList
diff --git a/src/add-ons/kernel/bus_managers/usb/usb_private.h b/src/add-ons/kernel/bus_managers/usb/usb_private.h
index 23cde3f3f4..de5a4a4d36 100644
--- a/src/add-ons/kernel/bus_managers/usb/usb_private.h
+++ b/src/add-ons/kernel/bus_managers/usb/usb_private.h
@@ -629,6 +629,11 @@ protected:
 		bool							fInitOK;
 
 private:
+		void							_RemoveEndpointPipes(
+											int32 interfaceIndex,
+											bool cancelTransfers);
+static	void							_CancelPipeTransfers(Pipe* pipe);
+
 		bool							fAvailable;
 		bool							fIsRootHub;
 		usb_configuration_info *		fConfigurations;
-- 
