-#define MAXFRAMEBUF CAMDEFRAMER_MAX_QUEUED_FRAMES
+static const int32 kMaxQueuedFrames = 2;
 
 
 UVCDeframer::UVCDeframer(CamDevice* device)
 	: CamDeframer(device),
 	fFrameCount(0),
-	fID(0)
+	fID(0),
+	fSynced(false),
+	fFrameBroken(false)
 {
+	uvc_sof_order_reset(&fSOFOrder);
