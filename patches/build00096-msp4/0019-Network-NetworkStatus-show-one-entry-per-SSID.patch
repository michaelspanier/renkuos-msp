+
 #include <MenuItem.h>
 #include <NetworkDevice.h>
 
@@ -24,6 +26,9 @@ public:
 
 	static	int					CompareSignalStrength(const BMenuItem* a,
 									const BMenuItem* b);
+	static	uint32				MergeSameName(wireless_network* networks,
