+
+PegelWindow::PegelWindow()
+	:
+	BWindow(BRect(100, 100, 560, 400), "Pegel", B_TITLED_WINDOW,
+		B_AUTO_UPDATE_SIZE_LIMITS | B_QUIT_ON_WINDOW_CLOSE | B_NOT_ZOOMABLE),
+	fRoster(BMediaRoster::Roster()),
+	fMicSlider(new BSlider("mic", "", new BMessage(kMsgMicGain), 0, 1,
+		B_HORIZONTAL)),
+	fMicMute(new BCheckBox("micMute", "Stumm", new BMessage(kMsgMicMute))),
+	fSpeakerSlider(new BSlider("speaker", "", new BMessage(kMsgSpeakerGain),
+		0, 1, B_HORIZONTAL)),
+	fSpeakerMute(new BCheckBox("speakerMute", "Stumm",
+		new BMessage(kMsgSpeakerMute))),
+	fMic(fMicSlider, fMicMute),
+	fSpeaker(fSpeakerSlider, fSpeakerMute),
+	fInputCount(0),
+	fRecorder(NULL),
+	fInputWeb(NULL),
+	fMixerWeb(NULL),
+	fMicCandidateCount(0),
+	fTicker(NULL),
+	fRescanRunner(NULL),
+	fNodeSignature(0),
+	fTickCount(0),
+	fQuietTicks(0)
+{
+	fMicSlider->SetModificationMessage(new BMessage(kMsgMicGain));
+	fSpeakerSlider->SetModificationMessage(new BMessage(kMsgSpeakerGain));
+
+	fInputField = new BMenuField("input", "Eingang:",
+		new BPopUpMenu("(keiner)"));
+	fMicParameterField = new BMenuField("micParameter", "Regler:",
+		new BPopUpMenu("(keiner)"));
+	fFormatView = new BStringView("format", "");
+	// Eigene Ansicht als Behälter: Ansichten in einem losen BGroupLayout
+	// werden nie an das Fenster gehängt und bleiben unsichtbar.
+	BGroupView* meters = new BGroupView(B_VERTICAL, 2);
+	for (int32 c = 0; c < kMaxMeters; c++) {
+		char label[16];
+		if (c == 0)
+			strlcpy(label, "L", sizeof(label));
+		else if (c == 1)
+			strlcpy(label, "R", sizeof(label));
+		else
+			snprintf(label, sizeof(label), "%d", (int)c + 1);
+		fMeters[c] = new MeterView(label);
+		meters->GroupLayout()->AddView(fMeters[c]);
+		if (c > 0)
+			fMeters[c]->Hide();
+	}
+	fShownMeters = 1;
+	fStereoView = new BStringView("stereo", "");
+	fDifferenceSum = 0;
+	fLevelSum = 0;
+
+	BLayoutBuilder::Group<>(this, B_VERTICAL, B_USE_DEFAULT_SPACING)
+		.SetInsets(B_USE_WINDOW_SPACING)
+		.Add(fInputField)
+		.Add(fFormatView)
+		.Add(meters)
+		.Add(fStereoView)
+		.AddStrut(B_USE_HALF_ITEM_SPACING)
+		.Add(new BStringView("micTitle", "Mikrofon-Verstärkung"))
+		.Add(fMicParameterField)
+		.AddGroup(B_HORIZONTAL)
+			.Add(fMicSlider, 1)
+			.Add(fMicMute)
+		.End()
+		.AddStrut(B_USE_HALF_ITEM_SPACING)
+		.Add(new BStringView("speakerTitle", "Lautsprecher (System-Mixer)"))
+		.AddGroup(B_HORIZONTAL)
+			.Add(fSpeakerSlider, 1)
+			.Add(fSpeakerMute)
+		.End();
+
+	if (fRoster == NULL) {
+		fFormatView->SetText("Media-Dienste laufen nicht.");
+		return;
+	}
+
+	_StartWatching();
+	_SetupSpeaker();
+	_FindInputs(NULL);
+
+	BMessage tick(kMsgTick);
+	fTicker = new BMessageRunner(BMessenger(this), &tick, kTickInterval);
+}
