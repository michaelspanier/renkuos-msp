+#ifndef FLICK_CONTROLS_H
+#define FLICK_CONTROLS_H
+
+
+#include <MediaNode.h>
+#include <Messenger.h>
+#include <Window.h>
+
+#include <vector>
+
+class BParameter;
+class BParameterGroup;
+class BParameterWeb;
+class BView;
+struct FlickControlEntry;
+
+
+/*!	The window with the picture settings of the camera: brightness, contrast,
+	white balance, exposure and so on. It shows what the camera reports in its
+	parameter web, one box for each group, and sends every change to the camera.
+*/
+class FlickControlsWindow : public BWindow {
+public:
+								FlickControlsWindow(const media_node& camera,
+									const BMessenger& owner);
+	virtual						~FlickControlsWindow();
+
+	//! B_OK if the camera has controls to show.
+			status_t			InitCheck() const { return fStatus; }
+
+	virtual	bool				QuitRequested();
+	virtual	void				MessageReceived(BMessage* message);
+
+private:
+			void				_Build();
+			void				_AddGroup(BParameterGroup* group,
+									BView* parent);
+			void				_AddParameter(BParameter* parameter,
+									BView* box);
+			void				_Change(BMessage* message);
+			void				_UpdateAutomatic(int32 group);
+
+			BParameterWeb*		fWeb;
+			media_node			fCamera;
+			BMessenger			fOwner;
+			status_t			fStatus;
+			std::vector<FlickControlEntry*>	fEntries;
+			int32				fGroupCount;
+};
+
+
+#endif	// FLICK_CONTROLS_H
diff --git a/src/apps/flick/FlickControlsLogic.h b/src/apps/flick/FlickControlsLogic.h
new file mode 100644
index 0000000000..802c8051c1
--- /dev/null
+++ b/src/apps/flick/FlickControlsLogic.h
@@ -0,0 +1,82 @@
+/*
+ * Copyright 2026, Michael Spanier.
+ * Distributed under the terms of the MIT License.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef FLICK_CONTROLS_LOGIC_H
+#define FLICK_CONTROLS_LOGIC_H
+
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+
+static const int32_t kFlickMaxSliderSteps = 100000;
+static const int32_t kFlickDefaultSliderSteps = 1000;
+
+
+/*!	Tells whether a group of the camera's parameter web is left out of the
+	controls: the info text and the format list, because Flick sets the size
+	itself.
+*/
+static inline bool
+flick_control_group_is_hidden(const char* name)
+{
+	return name == NULL || name[0] == '\0' || strcmp(name, "Info") == 0
+		|| strcmp(name, "Format") == 0;
+}
+
+
+/*!	How many steps a slider for the range \a minimum to \a maximum has, when
+	the camera counts in steps of \a step. Without a usable step the slider
+	gets a fixed number of steps. Returns 0 for a range that has no width:
+	there is nothing to move.
+*/
+static inline int32_t
+flick_slider_steps(float minimum, float maximum, float step)
+{
+	if (!(maximum > minimum))
+		return 0;
+
+	if (step > 0.0f) {
+		float steps = floorf((maximum - minimum) / step + 0.5f);
+		if (steps >= 1.0f && steps <= (float)kFlickMaxSliderSteps)
+			return (int32_t)steps;
+	}
+	return kFlickDefaultSliderSteps;
+}
+
+
+//!	The slider position (0 to \a steps) that shows \a value.
+static inline int32_t
+flick_slider_position(float value, float minimum, float maximum, int32_t steps)
+{
+	if (steps <= 0 || !(maximum > minimum) || !(value == value))
+		return 0;
+	if (value <= minimum)
+		return 0;
+	if (value >= maximum)
+		return steps;
+
+	return (int32_t)floorf((value - minimum) / (maximum - minimum)
+		* (float)steps + 0.5f);
+}
+
+
+//!	The parameter value that a slider \a position stands for.
+static inline float
+flick_slider_value(int32_t position, float minimum, float maximum,
+	int32_t steps)
+{
+	if (steps <= 0 || position <= 0)
+		return minimum;
+	if (position >= steps)
+		return maximum;
+
+	return minimum + (maximum - minimum) * (float)position / (float)steps;
+}
+
+
+#endif	// FLICK_CONTROLS_LOGIC_H
diff --git a/src/apps/flick/FlickIcons.cpp b/src/apps/flick/FlickIcons.cpp
new file mode 100644
index 0000000000..01b430ee6b
--- /dev/null
+++ b/src/apps/flick/FlickIcons.cpp
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026, Michael Spanier.
+ * Distributed under the terms of the MIT License.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "FlickIcons.h"
+
+#include <Bitmap.h>
+#include <InterfaceDefs.h>
+#include <View.h>
+
+#include <math.h>
+#include <string.h>
+
+
+//!	A stopwatch: a ring, the button on top and one hand.
+static void
+draw_self_timer(BView* view, float size)
+{
+	float pen = max_c(1.5f, size / 12);
+	BPoint center(size / 2, size * 0.56f);
+	float radius = size * 0.36f;
+	view->SetPenSize(pen);
+	view->StrokeEllipse(center, radius, radius);
+	view->FillRect(BRect(size * 0.42f, size * 0.04f, size * 0.58f,
+		size * 0.14f));
+	view->StrokeLine(BPoint(center.x, center.y - radius),
+		BPoint(center.x, center.y - radius - size * 0.06f));
+	view->StrokeLine(center, BPoint(center.x + radius * 0.5f,
+		center.y - radius * 0.6f));
+}
+
+
+//!	Two arrow heads facing away from a line in the middle.
+static void
+draw_mirror(BView* view, float size)
+{
+	float middle = size / 2;
+	float gap = size * 0.09f;
+	float top = size * 0.2f;
+	float bottom = size * 0.8f;
+	BPoint left[3] = { BPoint(middle - gap, top), BPoint(middle - gap, bottom),
+		BPoint(size * 0.06f, size / 2) };
+	BPoint right[3] = { BPoint(middle + gap, top), BPoint(middle + gap, bottom),
+		BPoint(size * 0.94f, size / 2) };
+	view->FillPolygon(left, 3);
+	view->SetPenSize(max_c(1.0f, size / 16));
+	view->StrokePolygon(right, 3);
+
+	float dash = size / 8;
+	for (float y = 0; y < size; y += dash * 2)
+		view->StrokeLine(BPoint(middle, y), BPoint(middle, y + dash - 1));
+}
+
+
+//!	Three sliders with their knobs at different places.
+static void
+draw_settings(BView* view, float size)
+{
+	static const float kKnobs[3] = { 0.3f, 0.68f, 0.45f };
+	float pen = max_c(1.0f, size / 14);
+	float knob = size * 0.11f;
+	view->SetPenSize(pen);
+	for (int i = 0; i < 3; i++) {
+		float y = size * (0.2f + 0.3f * i);
+		view->StrokeLine(BPoint(size * 0.08f, y), BPoint(size * 0.92f, y));
+		view->FillEllipse(BPoint(size * kKnobs[i], y), knob, knob);
+	}
+}
+
+
+BBitmap*
+flick_create_icon(flick_icon icon, float size)
+{
+	size = floorf(size);
+	BRect bounds(0, 0, size - 1, size - 1);
+	BBitmap* bitmap = new BBitmap(bounds, B_BITMAP_ACCEPTS_VIEWS, B_RGBA32);
+	if (bitmap->InitCheck() != B_OK) {
+		delete bitmap;
+		return NULL;
+	}
+	memset(bitmap->Bits(), 0, bitmap->BitsLength());
+
+	BView* view = new BView(bounds, "icon", B_FOLLOW_NONE, 0);
+	bitmap->AddChild(view);
+	bitmap->Lock();
+	view->SetDrawingMode(B_OP_ALPHA);
+	view->SetBlendingMode(B_PIXEL_ALPHA, B_ALPHA_COMPOSITE);
+	view->SetHighColor(ui_color(B_CONTROL_TEXT_COLOR));
+
+	switch (icon) {
+		case FLICK_ICON_SELF_TIMER:
+			draw_self_timer(view, size);
+			break;
+		case FLICK_ICON_MIRROR:
+			draw_mirror(view, size);
+			break;
+		case FLICK_ICON_SETTINGS:
+			draw_settings(view, size);
+			break;
+	}
+
+	view->Sync();
+	bitmap->RemoveChild(view);
+	bitmap->Unlock();
+	delete view;
+	return bitmap;
+}
