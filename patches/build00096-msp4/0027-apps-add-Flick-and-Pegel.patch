+
+void
+PegelWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgTick:
+			_Tick();
+			break;
+		case kMsgInput:
+			_SelectInput(message->GetInt32("index", -1));
+			break;
+		case kMsgMicParameter:
+			_SelectMicParameter(message->GetInt32("index", -1));
+			break;
+		case kMsgMicGain:
+			fMic.ApplySlider();
+			break;
+		case kMsgMicMute:
+			fMic.ApplyMute();
+			break;
+		case kMsgSpeakerGain:
+			fSpeaker.ApplySlider();
+			break;
+		case kMsgSpeakerMute:
+			fSpeaker.ApplyMute();
+			break;
+		case kMsgRescan:
+			_Rescan();
+			break;
+		case B_MEDIA_SERVER_QUIT:
+			_ServerQuit();
+			break;
+		case B_MEDIA_SERVER_STARTED:
+			_ScheduleRescan(kServerStartDelay);
+			break;
+		default:
+			BWindow::MessageReceived(message);
+	}
+}
+
+
+void
+PegelWindow::_FindInputs(const char* preferredName)
+{
+	live_node_info nodes[32];
+	int32 count = 32;
+	if (fRoster->GetLiveNodes(nodes, &count) != B_OK)
+		count = 0;
+
+	BMenu* menu = fInputField->Menu();
+	while (BMenuItem* item = menu->RemoveItem((int32)0))
+		delete item;
+	fInputCount = 0;
+
+	int32 preferred = -1;
+	bool preferredIsBuiltIn = false;
+	bool preferredByName = false;
+	for (int32 i = 0; i < count && fInputCount < 32; i++) {
+		if ((nodes[i].node.kind & B_PHYSICAL_INPUT) == 0)
+			continue;
+		if (!_HasAudioOutput(nodes[i].node))
+			continue;
+
+		fInputs[fInputCount] = nodes[i];
+		BMessage* message = new BMessage(kMsgInput);
+		message->AddInt32("index", fInputCount);
+		char label[B_MEDIA_NAME_LENGTH + 16];
+		snprintf(label, sizeof(label), "%s (#%d)", nodes[i].name,
+			(int)nodes[i].node.node);
+		menu->AddItem(new BMenuItem(label, message));
+		// Den bisher gewählten Eingang wiederfinden, sonst das eingebaute
+		// HD Audio nur, wenn es nichts anderes gibt.
+		bool builtIn = strstr(nodes[i].name, "HD Audio") != NULL;
+		bool byName = preferredName != NULL
+			&& strcmp(nodes[i].name, preferredName) == 0;
+		if (!preferredByName && (byName || preferred < 0
+				|| (!builtIn && preferredIsBuiltIn))) {
+			preferred = fInputCount;
+			preferredIsBuiltIn = builtIn;
+			preferredByName = byName;
+		}
+		fInputCount++;
+	}
+
+	if (fInputCount == 0) {
+		_StopRecorder();
+		fCurrentName = "";
+		fFormatView->SetText("Kein Audio-Eingang gefunden.");
+		fMic.Bind(NULL, NULL);
+		return;
+	}
+	menu->ItemAt(preferred)->SetMarked(true);
+	_SelectInput(preferred);
+}
+
+
+void
+PegelWindow::_StartWatching()
+{
+	// Nur Start und Ende der Dienste: die meldet der Roster in dieser App
+	// selbst. Knoten-Meldungen (B_MEDIA_NODE_CREATED/DELETED) verschickt
+	// dagegen der media_server, und zwar unter einer Sperre, die auch sein
+	// Hauptthread braucht. Kam dieses Fenster mit dem Lesen nicht nach, lief
+	// sein Port voll, und der media_server stand still (21.11.2026 im
+	// Belastungstest). Neue Knoten findet _Tick() deshalb durch Nachsehen.
+	BMessenger self(this);
+	fRoster->StartWatching(self, B_MEDIA_SERVER_QUIT);
+	fRoster->StartWatching(self, B_MEDIA_SERVER_STARTED);
+}
+
+
+void
+PegelWindow::_ScheduleRescan(bigtime_t delay)
+{
+	delete fRescanRunner;
+	BMessage rescan(kMsgRescan);
+	fRescanRunner = new BMessageRunner(BMessenger(this), &rescan, delay, 1);
+}
+
+
+/*!	Sucht die Eingänge neu, nachdem Knoten gekommen oder gegangen sind.
+	Läuft der gewählte Eingang noch, bleibt die Aufnahme ungestört.
+*/
+void
+PegelWindow::_Rescan()
+{
+	delete fRescanRunner;
+	fRescanRunner = NULL;
+
+	bool currentAlive = false;
+	live_node_info nodes[32];
+	int32 count = 32;
+	if (fRecorder != NULL && fRoster->GetLiveNodes(nodes, &count) == B_OK) {
+		for (int32 i = 0; i < count; i++) {
+			if (nodes[i].node.node == fCurrentNode.node
+				&& fCurrentName == nodes[i].name)
+				currentAlive = true;
+		}
+	}
+
+	if (currentAlive) {
+		// Nur das Menü auffrischen, ohne die Verbindung anzufassen.
+		BString name = fCurrentName;
+		BMenu* menu = fInputField->Menu();
+		while (BMenuItem* item = menu->RemoveItem((int32)0))
+			delete item;
+		fInputCount = 0;
+		for (int32 i = 0; i < count && fInputCount < 32; i++) {
+			if ((nodes[i].node.kind & B_PHYSICAL_INPUT) == 0
+				|| !_HasAudioOutput(nodes[i].node))
+				continue;
+			fInputs[fInputCount] = nodes[i];
+			BMessage* message = new BMessage(kMsgInput);
+			message->AddInt32("index", fInputCount);
+			char label[B_MEDIA_NAME_LENGTH + 16];
+			snprintf(label, sizeof(label), "%s (#%d)", nodes[i].name,
+				(int)nodes[i].node.node);
+			BMenuItem* item = new BMenuItem(label, message);
+			item->SetMarked(nodes[i].node.node == fCurrentNode.node);
+			menu->AddItem(item);
+			fInputCount++;
+		}
+		return;
+	}
+
+	BString previous = fCurrentName;
+	_StopRecorder();
+	_SetupSpeaker();
+	_FindInputs(previous.Length() > 0 ? previous.String() : NULL);
+}
+
+
+//!	Die Media-Dienste sind weg: alles loslassen, was auf sie zeigt.
+void
+PegelWindow::_ServerQuit()
+{
+	delete fRescanRunner;
+	fRescanRunner = NULL;
+	_StopRecorder();
+	fMic.Bind(NULL, NULL);
+	fSpeaker.Bind(NULL, NULL);
+	delete fInputWeb;
+	fInputWeb = NULL;
+	delete fMixerWeb;
+	fMixerWeb = NULL;
+	BMenu* menu = fMicParameterField->Menu();
+	while (BMenuItem* item = menu->RemoveItem((int32)0))
+		delete item;
+	fMicCandidateCount = 0;
+	fMicParameterField->Menu()->Superitem()->SetLabel("(keiner)");
+	fFormatView->SetText("Media-Dienste beendet, warte auf Neustart …");
+	fDifferenceSum = 0;
+	fLevelSum = 0;
+	fStereoView->SetText("");
+	for (int32 c = 0; c < fShownMeters; c++)
+		fMeters[c]->SetLevel(kFloorDB, kFloorDB, false);
+}
+
+
+//!	Ob sich die Liste der laufenden Knoten seit dem letzten Blick geändert hat.
+bool
+PegelWindow::_NodesChanged()
+{
+	live_node_info nodes[32];
+	int32 count = 32;
+	if (fRoster->GetLiveNodes(nodes, &count) != B_OK)
+		return false;
+	uint32 signature = count;
+	for (int32 i = 0; i < count; i++)
+		signature = signature * 31 + nodes[i].node.node;
+	if (signature == fNodeSignature)
+		return false;
+	bool first = fNodeSignature == 0;
+	fNodeSignature = signature;
+	return !first;
+}
+
+
+/*!	Ob ein Knoten Audio liefert. Belegte Ausgänge zählen mit: hängt Pegel
+	selbst (oder eine andere App) schon dran, soll er im Menü bleiben.
+*/
+bool
+PegelWindow::_HasAudioOutput(const media_node& node)
+{
+	media_output outputs[16];
+	int32 count = 0;
+	if (fRoster->GetAllOutputsFor(node, outputs, 16, &count) != B_OK)
+		return false;
+	for (int32 i = 0; i < count; i++) {
+		if (outputs[i].format.type == B_MEDIA_RAW_AUDIO)
+			return true;
+	}
+	return false;
+}
+
+
+void
+PegelWindow::_StopRecorder()
+{
+	if (fRecorder == NULL)
+		return;
+	fRecorder->Stop();
+	fRecorder->Disconnect();
+	delete fRecorder;
+	fRecorder = NULL;
+}
+
+
+void
+PegelWindow::_SelectInput(int32 index)
+{
+	if (index < 0 || index >= fInputCount)
+		return;
+
+	_StopRecorder();
+	fMic.Bind(NULL, NULL);
+	delete fInputWeb;
+	fInputWeb = NULL;
+	fCurrentNode = fInputs[index].node;
+	fCurrentName = fInputs[index].name;
+
+	{
+		BAutolock _(fAccumulator.lock);
+		fAccumulator.Reset();
+	}
+
+	fRecorder = new BMediaRecorder("Pegel", B_MEDIA_RAW_AUDIO);
+	status_t status = fRecorder->InitCheck();
+	if (status == B_OK) {
+		fRecorder->SetHooks(buffer_hook, NULL, &fAccumulator);
+		media_format format;
+		format.type = B_MEDIA_RAW_AUDIO;
+		format.u.raw_audio = media_raw_audio_format::wildcard;
+		status = fRecorder->Connect(fCurrentNode, NULL, &format);
+	}
+	if (status == B_OK)
+		status = fRecorder->Start();
+
+	char text[128];
+	if (status == B_OK) {
+		const media_raw_audio_format& audio = fRecorder->Format().u.raw_audio;
+		snprintf(text, sizeof(text), "%.0f Hz, %d %s, %d Bit",
+			audio.frame_rate, (int)audio.channel_count,
+			audio.channel_count == 1 ? "Kanal" : "Kanäle",
+			(int)(sample_size(audio.format) * 8));
+	} else {
+		snprintf(text, sizeof(text), "Aufnahme nicht möglich: %s",
+			strerror(status));
+		_StopRecorder();
+	}
+	fFormatView->SetText(text);
+	fDifferenceSum = 0;
+	fLevelSum = 0;
+	fStereoView->SetText("");
+
+	if (fRoster->GetParameterWebFor(fCurrentNode, &fInputWeb) != B_OK)
+		fInputWeb = NULL;
+	_FillMicParameters();
+}
+
+
+void
+PegelWindow::_FillMicParameters()
+{
+	BMenu* menu = fMicParameterField->Menu();
+	while (BMenuItem* item = menu->RemoveItem((int32)0))
+		delete item;
+	fMicCandidateCount = 0;
+
+	if (fInputWeb != NULL) {
+		for (int32 i = 0; i < fInputWeb->CountGroups(); i++) {
+			BParameterGroup* group = fInputWeb->GroupAt(i);
+			if (!is_output_group(group->Name()))
+				_CollectMicParameters(group);
+		}
+	}
+
+	int32 best = -1;
+	int32 bestScore = -1;
+	for (int32 i = 0; i < fMicCandidateCount; i++) {
+		BContinuousParameter* gain = fMicCandidates[i];
+		int32 score = mic_score(gain);
+		if (is_muted(mute_in_group(gain->Group())))
+			score -= 8;
+		if (score > bestScore) {
+			bestScore = score;
+			best = i;
+		}
+
+		char label[160];
+		const char* name = gain->Name();
+		snprintf(label, sizeof(label), "%s%s%s  [%g … %g %s]",
+			gain->Group()->Name(), name[0] != '\0' ? " / " : "", name,
+			gain->MinValue(), gain->MaxValue(), gain->Unit());
+		BMessage* message = new BMessage(kMsgMicParameter);
+		message->AddInt32("index", i);
+		menu->AddItem(new BMenuItem(label, message));
+	}
+
+	if (best < 0) {
+		fMic.Bind(NULL, NULL);
+		return;
+	}
+	menu->ItemAt(best)->SetMarked(true);
+	_SelectMicParameter(best);
+}
+
+
+//! Sammelt die stufenlosen Regler einer Gruppe samt Untergruppen.
+void
+PegelWindow::_CollectMicParameters(BParameterGroup* group)
+{
+	for (int32 i = 0; i < group->CountParameters()
+			&& fMicCandidateCount < 64; i++) {
+		BParameter* parameter = group->ParameterAt(i);
+		if (parameter->Type() == BParameter::B_CONTINUOUS_PARAMETER) {
+			fMicCandidates[fMicCandidateCount++]
+				= (BContinuousParameter*)parameter;
+		}
+	}
+	for (int32 i = 0; i < group->CountGroups(); i++)
+		_CollectMicParameters(group->GroupAt(i));
+}
+
+
+void
+PegelWindow::_SelectMicParameter(int32 index)
+{
+	if (index < 0 || index >= fMicCandidateCount)
+		return;
+	BContinuousParameter* gain = fMicCandidates[index];
+	fMic.Bind(gain, mute_in_group(gain->Group()));
+}
+
+
+void
+PegelWindow::_SetupSpeaker()
+{
+	fSpeaker.Bind(NULL, NULL);
+	delete fMixerWeb;
+	fMixerWeb = NULL;
+
+	media_node mixer;
+	BContinuousParameter* gain = NULL;
+	BDiscreteParameter* mute = NULL;
+	if (fRoster->GetAudioMixer(&mixer) == B_OK
+		&& fRoster->GetParameterWebFor(mixer, &fMixerWeb) == B_OK) {
+		gain = mixer_master_gain(fMixerWeb);
+		if (gain != NULL)
+			mute = mute_in_group(gain->Group());
+		fRoster->ReleaseNode(mixer);
+	}
+	fSpeaker.Bind(gain, mute);
+}
+
+
+void
+PegelWindow::_Tick()
+{
+	Accumulator snapshot;
+	{
+		BAutolock _(fAccumulator.lock);
+		memcpy(snapshot.sumSquares, fAccumulator.sumSquares,
+			sizeof(snapshot.sumSquares));
+		memcpy(snapshot.peak, fAccumulator.peak, sizeof(snapshot.peak));
+		snapshot.differenceSquares = fAccumulator.differenceSquares;
+		snapshot.frames = fAccumulator.frames;
+		snapshot.channels = fAccumulator.channels;
+		snapshot.buffers = fAccumulator.buffers;
+		int32 channels = fAccumulator.channels;
+		fAccumulator.Reset();
+		fAccumulator.channels = channels;
+	}
+
+	if (fRecorder == NULL) {
+		// Reste aus der Zeit vor dem Trennen gehören zu keinem Eingang mehr.
+		snapshot.frames = 0;
+		snapshot.buffers = 0;
+		snapshot.channels = 0;
+	}
+
+	if (snapshot.buffers > 0)
+		fQuietTicks = 0;
+	else
+		fQuietTicks++;
+
+	int32 wanted = snapshot.channels < 1 ? 1
+		: snapshot.channels < kMaxMeters ? snapshot.channels : kMaxMeters;
+	if (snapshot.channels > 0 && wanted != fShownMeters) {
+		for (int32 c = 0; c < kMaxMeters; c++) {
+			if (c < wanted && fMeters[c]->IsHidden())
+				fMeters[c]->Show();
+			else if (c >= wanted && !fMeters[c]->IsHidden())
+				fMeters[c]->Hide();
+		}
+		fShownMeters = wanted;
+	}
+
+	// Puffer kommen seltener als die Anzeige: ohne neue Daten Wert halten,
+	// erst nach einer Sekunde ohne Puffer "kein Signal".
+	if (snapshot.frames > 0) {
+		for (int32 c = 0; c < fShownMeters; c++) {
+			fMeters[c]->SetLevel(
+				to_db(sqrtf(snapshot.sumSquares[c] / snapshot.frames)),
+				to_db(snapshot.peak[c]), true);
+		}
+		if (snapshot.channels >= 2) {
+			fDifferenceSum += snapshot.differenceSquares;
+			fLevelSum += (snapshot.sumSquares[0] + snapshot.sumSquares[1]) / 2;
+		}
+	} else if (fQuietTicks * kTickInterval > 1000000) {
+		for (int32 c = 0; c < fShownMeters; c++)
+			fMeters[c]->SetLevel(kFloorDB, kFloorDB, false);
+	}
+
+	if (fTickCount % kNodeCheckTicks == 0 && fRoster != NULL
+		&& fRescanRunner == NULL && _NodesChanged())
+		_Rescan();
+
+	if (++fTickCount % kRefreshTicks == 0) {
+		fMic.Refresh();
+		fSpeaker.Refresh();
+		_ShowStereoDifference();
+	}
+}
+
+
+/*!	Zeigt, wie verschieden L und R sind: Energie von (L - R) gegen den
+	mittleren Pegel, über die letzten Sekunden. Zwei echte Mikrofone liegen
+	einige dB darunter; ein doppelt geschickter Mono-Kanal ergibt exakt 0.
+*/
+void
+PegelWindow::_ShowStereoDifference()
+{
+	if (fShownMeters < 2) {
+		fStereoView->SetText("");
+		return;
+	}
+	if (fLevelSum <= 0)
+		return;
+
+	char text[128];
+	if (fDifferenceSum <= 0) {
+		strlcpy(text, "L und R sind identisch (Mono auf zwei Kanälen)",
+			sizeof(text));
+	} else {
+		// 0 dB oder mehr: L und R haben nichts gemeinsam (zwei Mikrofone in
+		// einem leisen Raum rauschen unabhängig). Je tiefer, desto ähnlicher.
+		float db = 10.0f * log10f(fDifferenceSum / fLevelSum);
+		const char* verdict = db > -3 ? "unabhängig"
+			: db > -20 ? "verschieden" : "fast gleich";
+		snprintf(text, sizeof(text), "L–R-Unterschied: %+.1f dB zum Pegel "
+			"(%s)", db, verdict);
+	}
+	fStereoView->SetText(text);
+
+	// Gleitend: ältere Sekunden zählen immer weniger.
+	fDifferenceSum *= 0.7;
+	fLevelSum *= 0.7;
+}
