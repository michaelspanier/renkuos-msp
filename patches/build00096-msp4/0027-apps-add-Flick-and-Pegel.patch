+static const uint32 kMsgCamera = 'FlCm';
+static const uint32 kMsgSize = 'FlSz';
+static const uint32 kMsgResetStatus = 'FlRs';
+static const uint32 kMsgStartCamera = 'FlSt';
+static const uint32 kMsgToggleRate = 'FlRt';
