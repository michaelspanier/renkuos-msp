+
+// #pragma mark - Regler für einen Parameter
+
+
+/*!	Ein Schieberegler für einen BContinuousParameter. Er rechnet in Zehnteln der
+	Einheit, damit 0,5-dB-Grenzen genau treffen, und rastet beim Verschieben
+	auf ganze dB ein (siehe _Snap()).
+*/
+class ParameterSlider {
+public:
+							ParameterSlider(BSlider* slider, BCheckBox* mute);
+
+			void			Bind(BContinuousParameter* gain,
+								BDiscreteParameter* mute);
+			void			Refresh();
+			void			ApplySlider();
+			void			ApplyMute();
+
+private:
+			float			_Snap(float value) const;
+			void			_UpdateLabel(float value);
+
+			BSlider*		fSlider;
+			BCheckBox*		fMute;
+			BContinuousParameter* fGain;
+			BDiscreteParameter* fMuteParameter;
+			bigtime_t		fLastUserChange;
+};
+
+
+ParameterSlider::ParameterSlider(BSlider* slider, BCheckBox* mute)
+	:
+	fSlider(slider),
+	fMute(mute),
+	fGain(NULL),
+	fMuteParameter(NULL),
+	fLastUserChange(0)
+{
+}
+
+
+void
+ParameterSlider::Bind(BContinuousParameter* gain, BDiscreteParameter* mute)
+{
+	fGain = gain;
+	fMuteParameter = mute;
+	fSlider->SetEnabled(gain != NULL);
+	fMute->SetEnabled(mute != NULL);
+	if (gain != NULL) {
+		fSlider->SetLimits((int32)roundf(gain->MinValue() * 10),
+			(int32)roundf(gain->MaxValue() * 10));
+		char minLabel[32];
+		char maxLabel[32];
+		snprintf(minLabel, sizeof(minLabel), "%g %s", gain->MinValue(),
+			gain->Unit());
+		snprintf(maxLabel, sizeof(maxLabel), "%g %s", gain->MaxValue(),
+			gain->Unit());
+		fSlider->SetLimitLabels(minLabel, maxLabel);
+		fSlider->SetKeyIncrementValue(10);
+			// Pfeiltasten: 1 dB je Druck
+	} else {
+		fSlider->SetLimitLabels("", "");
+		fSlider->SetLabel("(kein Regler)");
+	}
+	fLastUserChange = 0;
+	Refresh();
+}
+
+
+void
+ParameterSlider::Refresh()
+{
+	if (system_time() - fLastUserChange < kUserHold)
+		return;
+
+	if (fGain != NULL) {
+		float values[kMaxChannels];
+		size_t size = sizeof(values);
+		bigtime_t when;
+		if (fGain->GetValue(values, &size, &when) == B_OK
+			&& size >= sizeof(float)) {
+			fSlider->SetValue((int32)roundf(values[0] * 10));
+			_UpdateLabel(values[0]);
+		}
+	}
+	if (fMuteParameter != NULL) {
+		int32 value = 0;
+		size_t size = sizeof(value);
+		bigtime_t when;
+		if (fMuteParameter->GetValue(&value, &size, &when) == B_OK)
+			fMute->SetValue(value != 0 ? B_CONTROL_ON : B_CONTROL_OFF);
+	}
+}
+
+
+void
+ParameterSlider::ApplySlider()
+{
+	if (fGain == NULL)
+		return;
+	fLastUserChange = system_time();
+	float value = _Snap(fSlider->Value() / 10.0f);
+	fSlider->SetValue((int32)roundf(value * 10));
+	int32 channels = fGain->CountChannels();
+	if (channels < 1 || channels > kMaxChannels)
+		channels = 1;
+	float values[kMaxChannels];
+	for (int32 c = 0; c < channels; c++)
+		values[c] = value;
+	fGain->SetValue(values, channels * sizeof(float), system_time());
+	_UpdateLabel(value);
+}
+
+
+void
+ParameterSlider::ApplyMute()
+{
+	if (fMuteParameter == NULL)
+		return;
+	fLastUserChange = system_time();
+	int32 value = fMute->Value() == B_CONTROL_ON ? 1 : 0;
+	fMuteParameter->SetValue(&value, sizeof(value), system_time());
+}
+
+
+/*!	Rundet auf ganze Einheiten (1 dB), damit der Regler einrastet. Gibt der
+	Parameter einen größeren Schritt vor, gilt dieser. Die Grenzen bleiben
+	erreichbar, auch wenn sie keine ganze Zahl sind (zum Beispiel -34,5 dB).
+*/
+float
+ParameterSlider::_Snap(float value) const
+{
+	float step = fGain->ValueStep();
+	if (!(step > 1.0f))
+		step = 1.0f;
+	float snapped = roundf(value / step) * step;
+	if (snapped < fGain->MinValue())
+		snapped = fGain->MinValue();
+	if (snapped > fGain->MaxValue())
+		snapped = fGain->MaxValue();
+	return snapped;
+}
+
+
+void
+ParameterSlider::_UpdateLabel(float value)
+{
+	char label[64];
+	snprintf(label, sizeof(label), "%.1f %s", value, fGain->Unit());
+	fSlider->SetLabel(label);
+}
+
+
+// #pragma mark - Hilfen für Parameter-Netze
+
+
+static BDiscreteParameter*
+mute_in_group(BParameterGroup* group)
+{
+	for (int32 i = 0; i < group->CountParameters(); i++) {
+		BParameter* parameter = group->ParameterAt(i);
+		if (parameter->Type() == BParameter::B_DISCRETE_PARAMETER
+			&& strcmp(parameter->Kind(), B_MUTE) == 0)
+			return (BDiscreteParameter*)parameter;
+	}
+	return NULL;
+}
+
+
+static bool
+contains_word(const char* text, const char* const* words)
+{
+	for (int32 i = 0; words[i] != NULL; i++) {
+		if (strcasestr(text, words[i]) != NULL)
+			return true;
+	}
+	return false;
+}
+
+
+/*!	Ob eine oberste Gruppe zur Wiedergabe gehört. Der HD-Audio-Knoten ist
+	Ein- und Ausgang zugleich; Ausgangsregler gehören nicht ins Menü der
+	Mikrofon-Verstärkung.
+*/
+static bool
+is_output_group(const char* name)
+{
+	static const char* const kOutputWords[] = { "output", "ausgang",
+		"playback", "wiedergabe", NULL };
+	return contains_word(name, kOutputWords);
+}
+
+
+static bool
+is_muted(BDiscreteParameter* mute)
+{
+	if (mute == NULL)
+		return false;
+	int32 value = 0;
+	size_t size = sizeof(value);
+	bigtime_t when;
+	return mute->GetValue(&value, &size, &when) == B_OK && value != 0;
+}
+
+
+//! Bewertet, wie wahrscheinlich ein Regler die Eingangsverstärkung ist.
+static int32
+mic_score(BContinuousParameter* parameter)
+{
+	static const char* const kInputWords[] = { "mic", "eingang", "input",
+		"capture", "record", "aufnahme", NULL };
+	int32 score = 0;
+	if (strcmp(parameter->Kind(), B_GAIN) == 0
+		|| strcmp(parameter->Kind(), B_MASTER_GAIN) == 0)
+		score += 2;
+	if (strcasecmp(parameter->Unit(), "dB") == 0)
+		score += 1;
+	if (contains_word(parameter->Group()->Name(), kInputWords)
+		|| contains_word(parameter->Name(), kInputWords))
+		score += 4;
+	return score;
+}
+
+
+static BContinuousParameter*
+mixer_master_gain(BParameterWeb* web)
+{
+	BContinuousParameter* first = NULL;
+	for (int32 i = 0; i < web->CountParameters(); i++) {
+		BParameter* parameter = web->ParameterAt(i);
+		if (parameter->Type() != BParameter::B_CONTINUOUS_PARAMETER)
+			continue;
+		if (strcmp(parameter->Kind(), B_MASTER_GAIN) == 0)
+			return (BContinuousParameter*)parameter;
+		if (first == NULL)
+			first = (BContinuousParameter*)parameter;
+	}
+	return first;
+}
