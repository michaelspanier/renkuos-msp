+
+PegelWindow::~PegelWindow()
+{
+	delete fTicker;
+	delete fRescanRunner;
+	if (fRoster != NULL)
+		fRoster->StopWatching(BMessenger(this));
+	_StopRecorder();
+	delete fInputWeb;
+	delete fMixerWeb;
+}
