+/*
+ * Pegel: zeigt den Pegel eines Audio-Eingangs und stellt Mikrofon-Verstärkung
+ * und Lautsprecher-Lautstärke ein.
+ *
+ * - Eingang: jeder laufende Knoten mit B_PHYSICAL_INPUT und Audio-Ausgang.
+ * - Mikrofon-Regler: ein kontinuierlicher Parameter dieses Knotens (Vorauswahl
+ *   nach Name und Art, im Menü änderbar), dazu dessen Stumm-Schalter.
+ * - Lautsprecher: Hauptlautstärke und Stumm des System-Mixers.
+ *
+ * Gespeichert wird nichts. Werte, die woanders geändert werden, übernimmt die
+ * Anzeige alle halbe Sekunde.
+ */
+
+
+#include <Application.h>
+#include <CheckBox.h>
+#include <GroupView.h>
+#include <Autolock.h>
+#include <LayoutBuilder.h>
+#include <Locker.h>
+#include <MediaDefs.h>
+#include <MediaRecorder.h>
+#include <MediaRoster.h>
+#include <MenuField.h>
+#include <MenuItem.h>
+#include <MessageRunner.h>
+#include <ParameterWeb.h>
+#include <PopUpMenu.h>
+#include <Slider.h>
+#include <String.h>
+#include <StringView.h>
+#include <View.h>
+#include <Window.h>
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+
+static const uint32 kMsgTick = 'tick';
+static const uint32 kMsgInput = 'inpt';
+static const uint32 kMsgMicParameter = 'mprm';
+static const uint32 kMsgMicGain = 'mgai';
+static const uint32 kMsgMicMute = 'mmut';
+static const uint32 kMsgSpeakerGain = 'sgai';
+static const uint32 kMsgSpeakerMute = 'smut';
+static const uint32 kMsgRescan = 'rscn';
+
+static const bigtime_t kTickInterval = 50000;
+static const int32 kNodeCheckTicks = 40;
+	// Alle 2 s nachsehen, ob Knoten gekommen oder gegangen sind.
+static const bigtime_t kServerStartDelay = 3000000;
+	// Der media_addon_server legt seine Knoten erst nach dem media_server an.
+static const int32 kRefreshTicks = 10;
+static const bigtime_t kUserHold = 1000000;
+static const bigtime_t kPeakHold = 1500000;
+static const float kFloorDB = -80.0f;
+static const int32 kMaxChannels = 16;
+static const int32 kMaxMeters = 8;
+
+
+// #pragma mark - Pegelmessung (läuft im Thread des Recorders)
+
+
+struct Accumulator {
+	BLocker		lock;
+	double		sumSquares[kMaxMeters];
+	float		peak[kMaxMeters];
+	double		differenceSquares;
+		// Summe von (links - rechts)^2: zeigt, ob zwei Kanäle verschieden sind
+	int64		frames;
+	int32		channels;
+	int32		buffers;
+
+	Accumulator() { Reset(); }
+
+	void Reset()
+	{
+		for (int32 c = 0; c < kMaxMeters; c++) {
+			sumSquares[c] = 0;
+			peak[c] = 0;
+		}
+		differenceSquares = 0;
+		frames = 0;
+		channels = 0;
+		buffers = 0;
+	}
+};
+
+
+static float
+normalized_sample(const void* data, size_t index, uint32 type)
+{
+	switch (type) {
+		case media_raw_audio_format::B_AUDIO_FLOAT:
+			return ((const float*)data)[index];
+		case media_raw_audio_format::B_AUDIO_DOUBLE:
+			return (float)((const double*)data)[index];
+		case media_raw_audio_format::B_AUDIO_INT:
+			return ((const int32*)data)[index] / 2147483648.0f;
+		case media_raw_audio_format::B_AUDIO_SHORT:
+			return ((const int16*)data)[index] / 32768.0f;
+		case media_raw_audio_format::B_AUDIO_CHAR:
+			return ((const int8*)data)[index] / 128.0f;
+		case media_raw_audio_format::B_AUDIO_UCHAR:
+			return (((const uint8*)data)[index] - 128) / 128.0f;
+	}
+	return 0;
+}
+
+
+static size_t
+sample_size(uint32 type)
+{
+	return type & media_raw_audio_format::B_AUDIO_SIZE_MASK;
+}
+
+
+static void
+buffer_hook(void* cookie, bigtime_t /*time*/, void* data, size_t size,
+	const media_format& format)
+{
+	Accumulator* accumulator = (Accumulator*)cookie;
+	uint32 type = format.u.raw_audio.format;
+	size_t bytes = sample_size(type);
+	if (bytes == 0)
+		return;
+
+	int32 channels = format.u.raw_audio.channel_count;
+	if (channels < 1)
+		channels = 1;
+	int32 metered = channels < kMaxMeters ? channels : kMaxMeters;
+	size_t frames = size / bytes / channels;
+
+	double sums[kMaxMeters] = {};
+	float peaks[kMaxMeters] = {};
+	double difference = 0;
+	for (size_t frame = 0; frame < frames; frame++) {
+		size_t first = frame * channels;
+		for (int32 c = 0; c < metered; c++) {
+			float value = normalized_sample(data, first + c, type);
+			sums[c] += (double)value * value;
+			if (fabsf(value) > peaks[c])
+				peaks[c] = fabsf(value);
+		}
+		if (channels >= 2) {
+			float delta = normalized_sample(data, first, type)
+				- normalized_sample(data, first + 1, type);
+			difference += (double)delta * delta;
+		}
+	}
+
+	BAutolock _(accumulator->lock);
+	for (int32 c = 0; c < metered; c++) {
+		accumulator->sumSquares[c] += sums[c];
+		if (peaks[c] > accumulator->peak[c])
+			accumulator->peak[c] = peaks[c];
+	}
+	accumulator->differenceSquares += difference;
+	accumulator->frames += frames;
+	accumulator->channels = channels;
+	accumulator->buffers++;
+}
+
+
+static float
+to_db(float linear)
+{
+	if (linear <= 0)
+		return kFloorDB;
+	float db = 20.0f * log10f(linear);
+	return db < kFloorDB ? kFloorDB : db;
+}
+
+
+// #pragma mark - Pegelbalken
+
+
+class MeterView : public BView {
+public:
+							MeterView(const char* label);
+
+			void			SetLevel(float rmsDB, float peakDB, bool signal);
+
+	virtual	void			Draw(BRect updateRect);
+	virtual	BSize			MinSize();
+
+private:
+			float			_X(float db, BRect bounds) const;
+
+			BString			fLabel;
+			float			fRmsDB;
+			float			fPeakDB;
+			float			fHoldDB;
+			bigtime_t		fHoldTime;
+			bool			fSignal;
+};
+
+
+MeterView::MeterView(const char* label)
+	:
+	BView("meter", B_WILL_DRAW | B_FULL_UPDATE_ON_RESIZE),
+	fLabel(label),
+	fRmsDB(kFloorDB),
+	fPeakDB(kFloorDB),
+	fHoldDB(kFloorDB),
+	fHoldTime(0),
+	fSignal(false)
+{
+	SetViewColor(B_TRANSPARENT_COLOR);
+}
+
+
+void
+MeterView::SetLevel(float rmsDB, float peakDB, bool signal)
+{
+	fRmsDB = rmsDB;
+	fPeakDB = peakDB;
+	fSignal = signal;
+	bigtime_t now = system_time();
+	if (peakDB >= fHoldDB || now - fHoldTime > kPeakHold) {
+		fHoldDB = peakDB;
+		fHoldTime = now;
+	}
+	Invalidate();
+}
+
+
+float
+MeterView::_X(float db, BRect bounds) const
+{
+	float fraction = (db - kFloorDB) / -kFloorDB;
+	if (fraction < 0)
+		fraction = 0;
+	if (fraction > 1)
+		fraction = 1;
+	return bounds.left + fraction * bounds.Width();
+}
+
+
+void
+MeterView::Draw(BRect /*updateRect*/)
+{
+	BRect bounds = Bounds();
+	font_height height;
+	GetFontHeight(&height);
+	float textHeight = ceilf(height.ascent + height.descent);
+	BRect bar = bounds;
+	bar.bottom -= textHeight + 4;
+
+	SetHighColor(40, 40, 40);
+	FillRect(bounds);
+
+	// Effektivwert als Balken: grün bis -18 dB, gelb bis -6 dB, dann rot.
+	struct { float from, to; rgb_color color; } zones[] = {
+		{ kFloorDB, -18, { 60, 190, 60, 255 } },
+		{ -18, -6, { 220, 200, 40, 255 } },
+		{ -6, 0, { 220, 60, 50, 255 } },
+	};
+	for (size_t i = 0; i < sizeof(zones) / sizeof(zones[0]); i++) {
+		float top = fRmsDB < zones[i].to ? fRmsDB : zones[i].to;
+		if (top <= zones[i].from)
+			continue;
+		SetHighColor(zones[i].color);
+		FillRect(BRect(_X(zones[i].from, bar), bar.top + 2, _X(top, bar),
+			bar.bottom - 2));
+	}
+
+	// Spitze als dünner Balken darüber, gehaltene Spitze als Strich.
+	SetHighColor(200, 200, 200);
+	FillRect(BRect(bar.left, bar.top + 2, _X(fPeakDB, bar), bar.top + 4));
+	SetHighColor(255, 255, 255);
+	float holdX = _X(fHoldDB, bar);
+	StrokeLine(BPoint(holdX, bar.top), BPoint(holdX, bar.bottom));
+
+	// Skala alle 10 dB.
+	SetHighColor(120, 120, 120);
+	for (float db = kFloorDB; db <= 0; db += 10) {
+		float x = _X(db, bar);
+		StrokeLine(BPoint(x, bar.bottom - 3), BPoint(x, bar.bottom));
+	}
+
+	char text[96];
+	if (fSignal) {
+		snprintf(text, sizeof(text), "%s  Effektiv %.1f dBFS   Spitze %.1f dBFS",
+			fLabel.String(), fRmsDB, fHoldDB);
+	} else
+		snprintf(text, sizeof(text), "%s  kein Signal", fLabel.String());
+	SetHighColor(230, 230, 230);
+	SetLowColor(40, 40, 40);
+	DrawString(text, BPoint(bounds.left + 4, bounds.bottom - height.descent - 2));
+}
+
+
+BSize
+MeterView::MinSize()
+{
+	return BSize(360, 48);
+}
