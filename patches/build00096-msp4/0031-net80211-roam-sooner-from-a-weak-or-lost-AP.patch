-	CHECK(!SWITCH(&state, 26, 50, kStart + SEC(30)));
-	CHECK(SWITCH(&state, 26, 50, kStart + SEC(35)));
+	CHECK(!SWITCH(&state, 26, 40, kStart + SEC(29)));
+	CHECK(!SWITCH(&state, 26, 40, kStart + SEC(30)));
+	CHECK(SWITCH(&state, 26, 40, kStart + SEC(35)));
