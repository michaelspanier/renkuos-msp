diff --git a/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.c b/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.c
index 5e1f6b04e5..6a374349d1 100644
--- a/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.c
+++ b/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.c
@@ -52,6 +52,12 @@ ieee80211_roam_lost(const struct ieee80211_roam_params *rp, int cur)
 	return cur < rp->rp_lost_thres;
 }
 
+static int
+ieee80211_roam_weak(const struct ieee80211_roam_params *rp, int cur)
+{
+	return cur < rp->rp_weak_thres;
+}
+
 int
 ieee80211_roam_should_scan(const struct ieee80211_roam_params *rp,
     struct ieee80211_roam_state *rs, int cur, long long now)
@@ -69,12 +75,28 @@ ieee80211_roam_should_scan(const struct ieee80211_roam_params *rp,
 		 */
 		if (cur >= rp->rp_scan_thres + rp->rp_hysteresis / 2)
 			rs->rs_scan_gap = 0;
+		rs->rs_retry = 0;
 		return 0;
 	}
 
-	if (ieee80211_roam_lost(rp, cur)) {
-		/* The AP is going away: dwell time and backoff do not count. */
-		gap = rp->rp_scan_min;
+	if (rs->rs_retry != 0) {
+		/* The last request did not start a scan: try again soon. */
+		if (now < rs->rs_retry)
+			return 0;
+		gap = 0;
+	} else if (ieee80211_roam_weak(rp, cur)) {
+		/*
+		 * Weak or lost: look around often, even right after a
+		 * switch. While the signal stays put (standing in a room
+		 * where all APs are weak), at most every rp_scan_still:
+		 * every scan costs throughput.
+		 */
+		gap = ieee80211_roam_lost(rp, cur) ? rp->rp_scan_lost :
+		    rp->rp_scan_weak;
+		if (cur > rs->rs_scan_rssi - rp->rp_hysteresis / 2 &&
+		    rs->rs_scan_gap > gap)
+			gap = rs->rs_scan_gap < rp->rp_scan_still ?
+			    rs->rs_scan_gap : rp->rp_scan_still;
 	} else {
 		if (now - rs->rs_last_join < rp->rp_dwell)
 			return 0;
@@ -89,6 +111,7 @@ ieee80211_roam_should_scan(const struct ieee80211_roam_params *rp,
 	if (rs->rs_last_scan != 0 && now - rs->rs_last_scan < gap)
 		return 0;
 
+	rs->rs_retry = 0;
 	rs->rs_last_scan = now;
 	rs->rs_scan_rssi = cur;
 	return 1;
@@ -107,29 +130,56 @@ ieee80211_roam_scan_done(const struct ieee80211_roam_params *rp,
 		rs->rs_scan_gap = rp->rp_scan_max;
 }
 
+void
+ieee80211_roam_scan_refused(struct ieee80211_roam_state *rs, long long now)
+{
+	rs->rs_retry = now + IEEE80211_ROAM_RETRY;
+}
+
 int
 ieee80211_roam_should_switch(const struct ieee80211_roam_params *rp,
     struct ieee80211_roam_state *rs, int cur, int cand, unsigned id,
     long long now)
 {
+	int fast;
+
 	/* No other AP in this scan: nothing to confirm next time. */
 	if (cand <= 0 || id == 0) {
 		rs->rs_cand = 0;
 		return 0;
 	}
 
-	/* The current AP is practically gone: take anything better. */
+	/*
+	 * The current AP is practically gone: take at once one that is
+	 * not, and a bit stronger. Not one as weak, that would only start
+	 * a hectic hopping between weak APs.
+	 */
 	if (ieee80211_roam_lost(rp, cur)) {
 		rs->rs_cand = 0;
-		return cand > cur;
+		return !ieee80211_roam_lost(rp, cand) &&
+		    cand >= cur + rp->rp_hysteresis / 2;
 	}
 
-	if (now - rs->rs_last_join < rp->rp_dwell ||
-	    cand < cur + rp->rp_hysteresis) {
+	if (cand < cur + rp->rp_hysteresis) {
 		rs->rs_cand = 0;
 		return 0;
 	}
 
+	/*
+	 * The current AP is weak and the candidate far stronger: one scan
+	 * is enough, also within the dwell time. For a good current AP a
+	 * single outlier beacon must not cause a switch.
+	 */
+	fast = ieee80211_roam_weak(rp, cur) &&
+	    cand >= cur + rp->rp_hyst_fast;
+	if (fast) {
+		rs->rs_cand = 0;
+		return 1;
+	}
+	if (now - rs->rs_last_join < rp->rp_dwell) {
+		rs->rs_cand = 0;
+		return 0;
+	}
 	if (rs->rs_cand == id) {
 		rs->rs_cand = 0;
 		return 1;
diff --git a/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.h b/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.h
index 210e87aabe..5d764bede9 100644
--- a/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.h
+++ b/src/libs/compat/openbsd_wlan/net80211/ieee80211_roam_logic.h
@@ -22,10 +22,18 @@
  *  - a switch only to an AP that is at least rp_hysteresis better in
  *    two scans in a row (a single scan has one beacon per AP, which
  *    may be an outlier), and not within rp_dwell after the last switch;
+ *    if the current AP is weak, one scan is enough for an AP
+ *    rp_hyst_fast better, also within rp_dwell;
+ *  - below rp_weak_thres scans every rp_scan_weak (rp_scan_lost below
+ *    rp_lost_thres), regardless of the dwell time; while the signal
+ *    stays put the backoff applies, up to rp_scan_still;
+ *  - a scan request the stack could not start is retried after
+ *    IEEE80211_ROAM_RETRY (ieee80211_roam_scan_refused());
  *    The caller reports every scan to ieee80211_roam_should_switch(),
  *    with candidate 0 when the best AP found is the current one;
- *  - an AP below rp_lost_thres is practically gone: then scan soon
- *    and take any better AP at once.
+ *  - an AP below rp_lost_thres is practically gone: then scan every
+ *    rp_scan_lost and take at once an AP that is not lost and at least
+ *    rp_hysteresis / 2 stronger.
  */
 
 struct ieee80211_roam_params {
@@ -35,6 +43,11 @@ struct ieee80211_roam_params {
 	int		rp_dwell;	/* msec to stay after a switch */
 	int		rp_scan_min;	/* msec, first gap between scans */
 	int		rp_scan_max;	/* msec, largest gap between scans */
+	int		rp_weak_thres;	/* below this the AP is weak */
+	int		rp_hyst_fast;	/* this much stronger: switch at once */
+	int		rp_scan_weak;	/* msec, gap between scans while weak */
+	int		rp_scan_lost;	/* msec, gap between scans while lost */
+	int		rp_scan_still;	/* msec, largest gap while weak */
 };
 
 /* Smoothed signal of one AP; all zero means "no sample yet". */
@@ -50,11 +63,13 @@ struct ieee80211_roam_state {
 	int		rs_scan_gap;	/* msec, current gap between scans */
 	int		rs_scan_rssi;	/* smoothed RSSI at the last scan */
 	unsigned	rs_cand;	/* id of the candidate to confirm, 0 none */
+	long long	rs_retry;	/* msec, retry a refused scan then */
 };
 
 #define IEEE80211_ROAM_AVG_SHIFT	4	/* fixed point: 1/16 unit */
 #define IEEE80211_ROAM_AVG_WEIGHT	8	/* a sample counts 1/8 */
 #define IEEE80211_ROAM_AVG_PERIOD	100	/* msec, one sample per period */
+#define IEEE80211_ROAM_RETRY		500	/* msec, after a refused scan */
 
 #ifdef __cplusplus
 extern "C" {
@@ -67,6 +82,7 @@ int	ieee80211_roam_should_scan(const struct ieee80211_roam_params *,
 	    struct ieee80211_roam_state *, int, long long);
 void	ieee80211_roam_scan_done(const struct ieee80211_roam_params *,
 	    struct ieee80211_roam_state *);
+void	ieee80211_roam_scan_refused(struct ieee80211_roam_state *, long long);
 int	ieee80211_roam_should_switch(const struct ieee80211_roam_params *,
 	    struct ieee80211_roam_state *, int, int, unsigned, long long);
 void	ieee80211_roam_joined(const struct ieee80211_roam_params *,
diff --git a/src/tests/libs/compat/openbsd_wlan/roam_logic_test.c b/src/tests/libs/compat/openbsd_wlan/roam_logic_test.c
index 04ad468c9a..0310dc4130 100644
--- a/src/tests/libs/compat/openbsd_wlan/roam_logic_test.c
+++ b/src/tests/libs/compat/openbsd_wlan/roam_logic_test.c
@@ -37,6 +37,11 @@ static const struct ieee80211_roam_params kParams = {
 	30000,		/* rp_dwell */
 	5000,		/* rp_scan_min */
 	60000,		/* rp_scan_max */
+	20,		/* rp_weak_thres, 30 % */
+	15,		/* rp_hyst_fast */
+	2500,		/* rp_scan_weak */
+	1000,		/* rp_scan_lost */
+	10000,		/* rp_scan_still */
 };
 
 static const long long kStart = 100000;	/* uptime when tests begin */
@@ -198,7 +203,40 @@ test_switch_clear_gain(void)
 
 	joined_long_ago(&state);
 	CHECK(SWITCH2(&state, 26, 34, kStart));
-	CHECK(SWITCH2(&state, 26, 50, kStart + SEC(10)));
+	CHECK(SWITCH2(&state, 26, 40, kStart + SEC(10)));
+}
+
+
+static void
+test_switch_fast_gain(void)
+{
+	struct ieee80211_roam_state state;
+
+	/* Weak and far stronger: no need to wait for the next scan. */
+	joined_long_ago(&state);
+	CHECK(SWITCH(&state, 18, 33, kStart));
+	CHECK(!SWITCH(&state, 18, 32, kStart + SEC(5)));
+	/* A good AP waits for the confirmation (outliers). */
+	joined_long_ago(&state);
+	CHECK(!SWITCH(&state, 26, 45, kStart + SEC(10)));
+	CHECK(SWITCH(&state, 26, 45, kStart + SEC(15)));
+}
+
+
+static void
+test_switch_fast_gain_within_dwell_when_weak(void)
+{
+	struct ieee80211_roam_state state;
+
+	memset(&state, 0, sizeof(state));
+	ieee80211_roam_joined(&kParams, &state, kStart);
+	/* A good AP is kept for the dwell time, even for a far better one. */
+	CHECK(!SWITCH(&state, 26, 45, kStart + SEC(10)));
+	/* A weak one is left at once for a far better one, */
+	CHECK(SWITCH(&state, 18, 33, kStart + SEC(10)));
+	/* but not for one only clearly better. */
+	CHECK(!SWITCH(&state, 18, 32, kStart + SEC(15)));
+	CHECK(!SWITCH(&state, 18, 32, kStart + SEC(20)));
 }
 
 
@@ -269,12 +307,12 @@ test_switch_dwell(void)
 
