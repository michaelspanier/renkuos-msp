From aa1020577841215eda5519f064e376c4d6a63bd7 Mon Sep 17 00:00:00 2001
From: Michael Spanier <spanier.michael@gmail.com>
Date: Sun, 22 Nov 2026 19:55:20 +0000
Subject: [PATCH 38/43] acpi_battery: read and set the charge thresholds of
 ThinkPads

Add the ioctls GET_BATTERY_CHARGE_THRESHOLDS and
SET_BATTERY_CHARGE_THRESHOLDS to the battery devices, with start and
stop in percent. On a ThinkPad they find the hotkey device (LEN0068,
LEN0268, IBM0068) and call its charge methods for the battery that
matches the ACPI device name. Without the hotkey device, or when the
firmware does not mark support, both return B_NOT_SUPPORTED.

Setting needs root, and the values are checked before the firmware is
called. The embedded controller stores the thresholds itself, so they
also hold while the laptop is off or runs another system.

The ThinkPad code lives in its own file, so acpi_battery.cpp only
gains the two ioctls and a helper for the ACPI path.

Signed-off-by: Michael Spanier <spanier.michael@gmail.com>
Assisted-by: claude-opus-5-5
(cherry picked from commit 40ea63654c90d7b3c769494a5ee3cad639961f5b)
---
 headers/private/device/power_managment.h      |  12 +-
 .../kernel/drivers/power/acpi_battery/Jamfile |   2 +
 .../power/acpi_battery/acpi_battery.cpp       |  55 ++++++
 .../power/acpi_battery/thinkpad_charge.cpp    | 180 ++++++++++++++++++
 .../power/acpi_battery/thinkpad_charge.h      |  20 ++
 5 files changed, 268 insertions(+), 1 deletion(-)
 create mode 100644 src/add-ons/kernel/drivers/power/acpi_battery/thinkpad_charge.cpp
 create mode 100644 src/add-ons/kernel/drivers/power/acpi_battery/thinkpad_charge.h

diff --git a/headers/private/device/power_managment.h b/headers/private/device/power_managment.h
index aa3126a95e..b51aa87394 100644
--- a/headers/private/device/power_managment.h
+++ b/headers/private/device/power_managment.h
@@ -17,7 +17,9 @@ enum {
 	GET_BATTERY_INFO,
 	GET_EXTENDED_BATTERY_INFO,
 	WATCH_BATTERY,
-	STOP_WATCHING_BATTERY
+	STOP_WATCHING_BATTERY,
+	GET_BATTERY_CHARGE_THRESHOLDS,
+	SET_BATTERY_CHARGE_THRESHOLDS
 };
 
 
@@ -78,4 +80,12 @@ typedef struct {
 } acpi_extended_battery_info;
 
 
+// Charge thresholds in percent: charging starts below start and stops at
+// stop. A start of 0 leaves it to the firmware, a stop of 100 charges fully.
+typedef struct {
+	uint32	start;
+	uint32	stop;
+} acpi_battery_charge_thresholds;
+
+
 #endif
diff --git a/src/add-ons/kernel/drivers/power/acpi_battery/Jamfile b/src/add-ons/kernel/drivers/power/acpi_battery/Jamfile
index ae692be826..e286b65127 100644
--- a/src/add-ons/kernel/drivers/power/acpi_battery/Jamfile
+++ b/src/add-ons/kernel/drivers/power/acpi_battery/Jamfile
@@ -4,6 +4,8 @@ UsePrivateKernelHeaders ;
 
 KernelAddon acpi_battery :
 	acpi_battery.cpp
+	thinkpad_charge.cpp
+	thinkpad_charge_logic.cpp
 	;
 
 Depends acpi_battery : acpi ;
diff --git a/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp b/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp
index f7f3614397..ab52b0242d 100644
--- a/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp
+++ b/src/add-ons/kernel/drivers/power/acpi_battery/acpi_battery.cpp
@@ -16,10 +16,12 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
 
 #include <kernel.h>
 
 #include "device/power_managment.h"
+#include "thinkpad_charge.h"
 
 
 struct battery_driver_cookie {
@@ -415,6 +417,20 @@ acpi_battery_write(void* cookie, off_t position, const void* buffer,
 }
 
 
+static status_t
+battery_acpi_path(battery_driver_cookie* cookie, char* path, size_t size)
+{
+	device_node* parent = sDeviceManager->get_parent_node(cookie->node);
+	const char* acpiPath;
+	status_t status = sDeviceManager->get_attr_string(parent,
+		ACPI_DEVICE_PATH_ITEM, &acpiPath, false);
+	if (status == B_OK)
+		strlcpy(path, acpiPath, size);
+	sDeviceManager->put_node(parent);
+	return status;
+}
+
+
 static status_t
 acpi_battery_control(void* _cookie, uint32 op, void* arg, size_t len)
 {
@@ -478,6 +494,45 @@ acpi_battery_control(void* _cookie, uint32 op, void* arg, size_t len)
 			atomic_set(&(device->stop_watching), 1);
 			sBatteryCondition.NotifyAll();
 			return B_OK;
+
+		case GET_BATTERY_CHARGE_THRESHOLDS: {
+			if (len < sizeof(acpi_battery_charge_thresholds))
+				return B_BAD_VALUE;
+
+			char path[255];
+			err = battery_acpi_path(device->driver_cookie, path, sizeof(path));
+			if (err != B_OK)
+				return B_NOT_SUPPORTED;
+
+			acpi_battery_charge_thresholds thresholds;
+			err = thinkpad_get_charge_thresholds(path, &thresholds);
+			if (err != B_OK)
+				return err;
+			if (!IS_USER_ADDRESS(arg)
+				|| user_memcpy(arg, &thresholds, sizeof(thresholds)) < B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			return B_OK;
+		}
+
+		case SET_BATTERY_CHARGE_THRESHOLDS: {
+			if (geteuid() != 0)
+				return B_NOT_ALLOWED;
+			if (len < sizeof(acpi_battery_charge_thresholds))
+				return B_BAD_VALUE;
+
+			acpi_battery_charge_thresholds thresholds;
+			if (!IS_USER_ADDRESS(arg)
+				|| user_memcpy(&thresholds, arg, sizeof(thresholds)) < B_OK) {
+				return B_BAD_ADDRESS;
+			}
+
+			char path[255];
+			err = battery_acpi_path(device->driver_cookie, path, sizeof(path));
+			if (err != B_OK)
+				return B_NOT_SUPPORTED;
+			return thinkpad_set_charge_thresholds(path, &thresholds);
+		}
 	}
 
 	return B_DEV_INVALID_IOCTL;
diff --git a/src/add-ons/kernel/drivers/power/acpi_battery/thinkpad_charge.cpp b/src/add-ons/kernel/drivers/power/acpi_battery/thinkpad_charge.cpp
new file mode 100644
index 0000000000..becbe11aff
--- /dev/null
+++ b/src/add-ons/kernel/drivers/power/acpi_battery/thinkpad_charge.cpp
@@ -0,0 +1,180 @@
+/*
+ * Copyright 2026, Michael Spanier.
+ * Distributed under the terms of the MIT License.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "thinkpad_charge.h"
+
+#include <ACPI.h>
+#include <KernelExport.h>
+
+#include "thinkpad_charge_logic.h"
+
+
+#define ERROR(x...) dprintf("acpi_battery: " x)
+
+
+// Hardware ids of the ThinkPad hotkey device, which has the charge methods.
+static const char* const kHotkeyIds[] = {
+	"LEN0068",
+	"LEN0268",
+	"IBM0068"
+};
+
+
+static status_t
+find_hotkey(acpi_module_info* acpi, acpi_handle* hotkey)
+{
+	char path[255];
+	for (size_t i = 0; i < B_COUNT_OF(kHotkeyIds); i++) {
+		if (acpi->get_device(kHotkeyIds[i], 0, path, sizeof(path)) == B_OK
+			&& acpi->get_handle(NULL, path, hotkey) == B_OK) {
+			return B_OK;
+		}
+	}
+	return B_NOT_SUPPORTED;
+}
+
+
+static status_t
+call_hotkey(acpi_module_info* acpi, acpi_handle hotkey, const char* method,
+	uint32 argument, uint32* result)
+{
+	acpi_object_type argumentObject;
+	argumentObject.object_type = ACPI_TYPE_INTEGER;
+	argumentObject.integer.integer = argument;
+
+	acpi_objects arguments;
+	arguments.count = 1;
+	arguments.pointer = &argumentObject;
+
+	acpi_object_type resultObject;
+	acpi_data buffer;
+	buffer.pointer = &resultObject;
+	buffer.length = sizeof(resultObject);
+
+	status_t status = acpi->evaluate_method(hotkey, method, &arguments,
+		&buffer);
+	if (status != B_OK)
+		return status;
+	if (resultObject.object_type != ACPI_TYPE_INTEGER)
+		return B_BAD_DATA;
+
+	*result = (uint32)resultObject.integer.integer;
+	return B_OK;
+}
+
+
+/*!	Reads the thresholds of the battery at \a batteryPath and checks that
+	the embedded controller supports them, as the thinkpad_acpi driver of
+	Linux does.
+*/
+static status_t
+read_thresholds(acpi_module_info* acpi, const char* batteryPath,
+	acpi_handle* _hotkey, int32* _battery,
+	acpi_battery_charge_thresholds* thresholds)
+{
+	int32 battery = thinkpad_battery_from_path(batteryPath);
+	if (battery == THINKPAD_BATTERY_UNKNOWN)
+		return B_NOT_SUPPORTED;
+
+	acpi_handle hotkey;
+	status_t status = find_hotkey(acpi, &hotkey);
+	if (status != B_OK)
+		return status;
+
+	uint32 start;
+	if (call_hotkey(acpi, hotkey, "BCTG", battery, &start) != B_OK
+		|| !thinkpad_threshold_supported(start)) {
+		return B_NOT_SUPPORTED;
+	}
+
+	// Without individual addressing, only the primary battery is known.
+	if (battery != THINKPAD_BATTERY_PRIMARY
+		&& !thinkpad_individual_addressing(start)) {
+		return B_NOT_SUPPORTED;
+	}
+
+	uint32 stop;
+	if (call_hotkey(acpi, hotkey, "BCSG", battery, &stop) != B_OK
+		|| !thinkpad_threshold_supported(stop)) {
+		return B_NOT_SUPPORTED;
+	}
+
+	thresholds->start = thinkpad_start_from_result(start);
+	thresholds->stop = thinkpad_stop_from_result(stop);
+	*_hotkey = hotkey;
+	*_battery = battery;
+	return B_OK;
+}
+
+
+static status_t
+set_threshold(acpi_module_info* acpi, acpi_handle hotkey, const char* method,
+	uint32 argument)
+{
+	uint32 result;
+	status_t status = call_hotkey(acpi, hotkey, method, argument, &result);
+	if (status == B_OK && thinkpad_call_failed(result))
+		status = B_IO_ERROR;
+	if (status != B_OK)
+		ERROR("%s(0x%" B_PRIx32 ") failed\n", method, argument);
+	return status;
+}
+
+
+status_t
+thinkpad_get_charge_thresholds(const char* batteryPath,
+	acpi_battery_charge_thresholds* thresholds)
+{
+	acpi_module_info* acpi;
+	if (get_module(B_ACPI_MODULE_NAME, (module_info**)&acpi) != B_OK)
+		return B_NOT_SUPPORTED;
+
+	acpi_handle hotkey;
+	int32 battery;
+	status_t status = read_thresholds(acpi, batteryPath, &hotkey, &battery,
+		thresholds);
+
+	put_module(B_ACPI_MODULE_NAME);
+	return status;
+}
+
+
+status_t
+thinkpad_set_charge_thresholds(const char* batteryPath,
+	const acpi_battery_charge_thresholds* thresholds)
+{
+	if (!charge_thresholds_valid(thresholds->start, thresholds->stop))
+		return B_BAD_VALUE;
+
+	acpi_module_info* acpi;
+	if (get_module(B_ACPI_MODULE_NAME, (module_info**)&acpi) != B_OK)
+		return B_NOT_SUPPORTED;
+
+	acpi_handle hotkey;
+	int32 battery;
+	acpi_battery_charge_thresholds current;
+	status_t status = read_thresholds(acpi, batteryPath, &hotkey, &battery,
+		&current);
+	if (status == B_OK) {
+		const char* methods[2] = { "BCSS", "BCCS" };
+		uint32 arguments[2] = {
+			thinkpad_stop_argument(battery, thresholds->stop),
+			thinkpad_start_argument(battery, thresholds->start)
+		};
+		int first = charge_set_start_first(current.start, thresholds->stop)
+			? 1 : 0;
+		status = set_threshold(acpi, hotkey, methods[first], arguments[first]);
+		if (status == B_OK) {
+			status = set_threshold(acpi, hotkey, methods[1 - first],
+				arguments[1 - first]);
+		}
+	}
+
+	put_module(B_ACPI_MODULE_NAME);
+	return status;
+}
