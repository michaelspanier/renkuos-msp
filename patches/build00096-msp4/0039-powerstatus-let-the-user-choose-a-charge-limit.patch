+status_t
+Battery::GetChargeThresholds(acpi_battery_charge_thresholds* thresholds)
+{
+	if (ioctl(fDriverHandler, GET_BATTERY_CHARGE_THRESHOLDS, thresholds,
+			sizeof(acpi_battery_charge_thresholds)) != 0)
+		return errno;
+
+	return B_OK;
