 	bool streamingFound = false;
 	for (uint32 i = 0; i < _device->CountConfigurations(); i++) {
 		config = _device->ConfigurationAt(i);
@@ -127,6 +129,12 @@ UVCCamDevice::UVCCamDevice(CamDeviceAddon& _addon, BUSBDevice* _device)
 				printf("UVCCamDevice: (%" B_PRIu32 ",%" B_PRIu32 "): Found Video Control "
 					"interface.\n", i, j);
 
+				// A camera may have more than one video function, as a color
+				// and an infrared one. Only the first one is driven.
+				if (controlFound)
+					continue;
+				controlFound = true;
+
 				// look for class specific interface descriptors and parse them
 				for (uint32 k = 0; interface->OtherDescriptorAt(k, generic,
 					sizeof(buffer)) == B_OK; k++) {
@@ -151,10 +159,15 @@ UVCCamDevice::UVCCamDevice(CamDeviceAddon& _addon, BUSBDevice* _device)
 					"interface.\n", i, j);
 
 				// Format and frame indices only hold within their interface,
-				// and the stream is set up on one. A second one, as of an
-				// infrared camera, is left alone.
-				if (streamingFound)
+				// and the stream is set up on one. Take the first one that the
+				// header of the control interface, which comes before it,
+				// lists. A second one, as of an infrared camera, is left alone.
+				if (streamingFound || !uvc_function_has_streaming(
+						(const uint8*)fHeaderDescriptor,
+						fHeaderDescriptor != NULL ? fHeaderDescriptor->length : 0,
+						interface->Descriptor()->interface_number)) {
 					continue;
+				}
 				streamingFound = true;
 
 				// An earlier run may have left an alternate setting active,
diff --git a/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCFunction.h b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCFunction.h
