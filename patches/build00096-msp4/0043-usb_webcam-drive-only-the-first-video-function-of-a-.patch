index 0000000000..3171caa58a
--- /dev/null
+++ b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCFunction.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright 2026, Michael Spanier.
+ * Distributed under the terms of the MIT License.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef UVC_FUNCTION_H
+#define UVC_FUNCTION_H
+
+
+#include <stddef.h>
+#include <stdint.h>
+
+
+//	The class specific VC interface header up to bInCollection, which is
+//	followed by baInterfaceNr[]. (UVC 1.0 § 3.7.2.)
+static const size_t kUVCControlHeaderLength = 12;
+static const size_t kUVCInCollectionOffset = 11;
+
+
+/*!	Whether the streaming interface \a number belongs to the video function
+	whose control interface has the class specific \a header of \a length
+	bytes. Without a header, or with an empty collection, every streaming
+	interface is taken to belong to it.
+*/
+static inline bool
+uvc_function_has_streaming(const uint8_t* header, size_t length,
+	uint8_t number)
+{
+	if (header == NULL || length < kUVCControlHeaderLength)
+		return true;
+
+	size_t count = header[kUVCInCollectionOffset];
+	if (count > length - kUVCControlHeaderLength)
+		count = length - kUVCControlHeaderLength;
+	if (count == 0)
+		return true;
+
+	for (size_t i = 0; i < count; i++) {
+		if (header[kUVCControlHeaderLength + i] == number)
+			return true;
+	}
+	return false;
+}
+
+
+#endif	// UVC_FUNCTION_H
