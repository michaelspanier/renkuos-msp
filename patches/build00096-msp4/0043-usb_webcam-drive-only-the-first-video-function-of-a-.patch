diff --git a/src/tests/add-ons/media/usb_webcam/UVCFunctionTest.cpp b/src/tests/add-ons/media/usb_webcam/UVCFunctionTest.cpp
new file mode 100644
index 0000000000..ec8c5b1661
--- /dev/null
+++ b/src/tests/add-ons/media/usb_webcam/UVCFunctionTest.cpp
@@ -0,0 +1,130 @@
+/*
+ * Copyright 2026, Michael Spanier.
+ * Distributed under the terms of the MIT License.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "UVCFunction.h"
+
+#include <stdio.h>
+
+
+static int sFailures = 0;
+static int sTests = 0;
+
+
+#define CHECK(condition) \
+	do { \
+		if (!(condition)) { \
+			printf("  FAILED %s:%d: %s\n", __FILE__, __LINE__, #condition); \
+			sFailures++; \
+		} \
+	} while (0)
+
+
+// A VC header like that of the color function of the Dell XPS 15 9520 camera
+// (0c45:6d1f): UVC 1.0, one streaming interface, number 1.
+static const uint8_t kColorHeader[] = {
+	0x0d, 0x24, 0x01, 0x00, 0x01, 0x4e, 0x00, 0x80, 0xc3, 0xc9, 0x01, 0x01,
+	0x01
+};
+
+// The infrared function of the same camera lists streaming interface 3.
+static const uint8_t kInfraredHeader[] = {
+	0x0d, 0x24, 0x01, 0x00, 0x01, 0x4e, 0x00, 0x80, 0xc3, 0xc9, 0x01, 0x01,
+	0x03
+};
+
+
+static void
+test_listed_streaming_interface_belongs()
+{
+	CHECK(uvc_function_has_streaming(kColorHeader, sizeof(kColorHeader), 1));
+	CHECK(uvc_function_has_streaming(kInfraredHeader, sizeof(kInfraredHeader),
+		3));
+}
+
+
+static void
+test_streaming_interface_of_other_function_is_left_alone()
+{
+	// The controls of the color camera must not drive the infrared stream.
+	CHECK(!uvc_function_has_streaming(kColorHeader, sizeof(kColorHeader), 3));
+	CHECK(!uvc_function_has_streaming(kInfraredHeader, sizeof(kInfraredHeader),
+		1));
+}
+
+
+static void
+test_any_of_several_listed_interfaces_belongs()
+{
+	const uint8_t header[] = {
+		0x0e, 0x24, 0x01, 0x10, 0x01, 0x4e, 0x00, 0x80, 0xc3, 0xc9, 0x01, 0x02,
+		0x01, 0x02
+	};
+	CHECK(uvc_function_has_streaming(header, sizeof(header), 1));
+	CHECK(uvc_function_has_streaming(header, sizeof(header), 2));
+	CHECK(!uvc_function_has_streaming(header, sizeof(header), 3));
+}
+
+
+static void
+test_without_header_every_interface_belongs()
+{
+	CHECK(uvc_function_has_streaming(NULL, 0, 1));
+	CHECK(uvc_function_has_streaming(kColorHeader, 0, 3));
+	CHECK(uvc_function_has_streaming(kColorHeader, kUVCControlHeaderLength - 1,
+		3));
+}
+
+
+static void
+test_empty_collection_takes_every_interface()
+{
+	const uint8_t header[] = {
+		0x0c, 0x24, 0x01, 0x00, 0x01, 0x4e, 0x00, 0x80, 0xc3, 0xc9, 0x01, 0x00
+	};
+	CHECK(uvc_function_has_streaming(header, sizeof(header), 1));
+	CHECK(uvc_function_has_streaming(header, sizeof(header), 3));
+}
+
+
+static void
+test_collection_is_cut_to_the_header_length()
+{
+	// bInCollection claims two interfaces, but only the first one is there.
+	const uint8_t header[] = {
+		0x0d, 0x24, 0x01, 0x00, 0x01, 0x4e, 0x00, 0x80, 0xc3, 0xc9, 0x01, 0x02,
+		0x01, 0x03
+	};
+	CHECK(uvc_function_has_streaming(header, 13, 1));
+	CHECK(!uvc_function_has_streaming(header, 13, 3));
+
+	// Nothing of the list is there: as if the header had none.
+	CHECK(uvc_function_has_streaming(header, kUVCControlHeaderLength, 3));
+}
+
+
+#define RUN(test) \
+	do { \
+		sTests++; \
+		int before = sFailures; \
+		test(); \
+		printf("%s %s\n", sFailures == before ? "ok    " : "FAILED", #test); \
+	} while (0)
+
+
+int
+main()
+{
+	RUN(test_listed_streaming_interface_belongs);
+	RUN(test_streaming_interface_of_other_function_is_left_alone);
+	RUN(test_any_of_several_listed_interfaces_belongs);
+	RUN(test_without_header_every_interface_belongs);
+	RUN(test_empty_collection_takes_every_interface);
+	RUN(test_collection_is_cut_to_the_header_length);
+	printf("%d tests, %d failures\n", sTests, sFailures);
+	return sFailures == 0 ? 0 : 1;
+}
